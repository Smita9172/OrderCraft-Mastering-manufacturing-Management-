# =============================================================================
# ORDERCRAFT ERP - ENVIRONMENT CONFIGURATION
# =============================================================================

SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False

# Comma-separated hostnames. Render automatically provides RENDER_EXTERNAL_HOSTNAME.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated full origins, including scheme.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# SUPABASE POSTGRESQL CONFIGURATION
# -----------------------------------------------------------------------------
# You can connect to Supabase PostgreSQL using EITHER Option 1 or Option 2:

# Option 1: Full Supabase Database URL (Found in Supabase Dashboard > Project Settings > Database > Connection URI)
DATABASE_URL=postgresql://postgres.your-project-id:your-supabase-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Option 2: Individual Supabase connection parameters
# SUPABASE_DB_HOST=aws-0-ap-south-1.pooler.supabase.com
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.your-project-id
# SUPABASE_DB_PASSWORD=your-supabase-db-password
# SUPABASE_DB_PORT=6543

# (Note: If neither is provided, OrderCraft automatically uses the local SQLite database db.sqlite3)
